    {
      "say": "doubles your lives to **18**",
      "file": "golf/putt/putt.js",
      "re": "LIVES_PASS = (\\d+)",
      "want": 18
    },
    {
      "say": "Each heart holds three lives",
      "file": "golf/putt/putt.js",
      "re": "var PER_HEART = (\\d+);",
      "want": 3
    },
    {
      "say": "**24 hours after you lost it**",
      "file": "golf/putt/putt.js",
      "re": "var LIFE_MS = (\\d+) \\* 3600 \\* 1000;",
      "want": 24
    },
    {
      "say": "Playing pays **40 coins**",
      "file": "golf/putt/putt.js",
      "re": "COIN_DAILY = (\\d+)",
      "want": 40
    },
    {
      "say": "under par pays **40 more**",
      "file": "golf/putt/putt.js",
      "re": "COIN_DAILY_PAR = (\\d+)",
      "want": 40
    },
    {
      "say": "the first hole of the tour",
