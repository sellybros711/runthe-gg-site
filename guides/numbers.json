  "_note": "Every number a guide states, pinned to the game code it comes from. check-guides fails if the code no longer gives that value, or if the guide stops saying it. A changed rule means a changed guide: edit guides/src, rebuild, and update the pin here in the same commit.",
  "putt-putt-stars-lives-worlds": [
    {
      "say": "A world is 18 holes",
      "file": "golf/putt/putt.js",
      "re": "var PER = (\\d+);",
      "want": 18
    },
    {
      "say": "That's 54 stars",
      "file": "golf/putt/putt.js",
      "re": "worldMax\\(TR, w\\)\\{[^}]*\\* (\\d+); \\}",
      "want": 3,
      "why": "54 is 18 holes times the 3 stars worldMax gives each"
    },
    {
      "say": "40 stars",
      "file": "golf/putt/putt.js",
      "re": "worldMax\\(TR, i\\) \\* (\\d+) / 54",
      "want": 40
    },
    {
      "say": "80 stars",
      "file": "golf/putt/putt.js",
      "re": "worldMax\\(TR, i\\) \\* \\d+ / (\\d+)",
      "want": 54,
      "why": "the gate is 40 of every 54, summed per world, so the second gate is 80"
    },
    {
      "say": "You start with **9 lives**",
      "file": "golf/putt/putt.js",
      "re": "LIVES_FREE = (\\d+)",
      "want": 9
