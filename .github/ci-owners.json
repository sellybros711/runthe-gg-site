{
  "_about": "Every scheduled workflow and the agent that owns it. ci-health.yml reads this to say who a failure belongs to, and a scheduled workflow missing from it fails ci-health (and the PR check), so a new schedule cannot go unwatched. seasonal: true means the schedule only fires in a season, so a long gap is not a stop. clock: true means the Cloudflare clock Worker (workers/clock/) starts it by workflow_dispatch, so its dispatched runs on main count too; maxGapHours sets how long it may go without any run (the heartbeat: 3). See scripts/qa/ci-health.mjs.",
  "workflows": {
    "arcade-stats.yml":          { "owner": "Rosters Agent" },
    "arcade-usage.yml":          { "owner": "Advisor Agent" },
    "awards.yml":                { "owner": "Rosters Agent" },
    "cfb-fantasy-injuries.yml":  { "owner": "College Football Agent", "seasonal": true },
    "cfb-fantasy-live.yml":      { "owner": "College Football Agent", "seasonal": true },
    "cfb-fantasy-pool.yml":      { "owner": "College Football Agent", "seasonal": true },
    "cfb-fantasy-watchdog.yml":  { "owner": "College Football Agent", "seasonal": true },
    "ci-health.yml":             { "owner": "QA Agent" },
    "clock-heartbeat.yml":       { "owner": "Perfect Season Agent", "clock": true, "maxGapHours": 3 },
    "fantasy-injuries.yml":      { "owner": "Perfect Season Agent", "seasonal": true },
    "fantasy-live.yml":          { "owner": "Perfect Season Agent", "seasonal": true, "clock": true },
    "fantasy-pipeline.yml":      { "owner": "Perfect Season Agent" },
    "fantasy-pool.yml":          { "owner": "Perfect Season Agent", "seasonal": true, "clock": true },
    "fantasy-watchdog.yml":      { "owner": "Perfect Season Agent", "seasonal": true, "clock": true },
    "former.yml":                { "owner": "Rosters Agent" },
    "golf-rosters.yml":          { "owner": "Rosters Agent" },
    "hoops-data.yml":            { "owner": "Rosters Agent" },
    "hoops-rosters.yml":         { "owner": "Rosters Agent" },
    "jerseys.yml":               { "owner": "Rosters Agent" },
    "leaderboard-stats.yml":     { "owner": "Advisor Agent" },
    "live-check.yml":            { "owner": "QA Agent" },
    "marketing-publish.yml":     { "owner": "Marketing Agent" },
    "nfl-schedule.yml":          { "owner": "Perfect Season Agent" },
    "player-register.yml":       { "owner": "Rosters Agent" },
    "qa-nightly.yml":            { "owner": "QA Agent" },
    "rosters.yml":               { "owner": "Rosters Agent" },
    "setlist-data.yml":          { "owner": "Segue Agent" },
    "shut-the-door-nightly.yml": { "owner": "Shut The Door Game Agent" },
    "sportegories.yml":          { "owner": "Rosters Agent" },
    "sportegories-watchdog.yml": { "owner": "Rosters Agent" },
    "stumpire-daily.yml":        { "owner": "the owner (Stumpire has no agent)" }
  }
}
