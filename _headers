# Cloudflare Pages response headers.
#
# WHY THIS EXISTS
#
# Segue is an HTML page that imports ES modules by name:
#
#   import { SETS, scoreShow, ... } from './scoring.js'
#
# The page and the modules are separate files, cached independently. When a
# release renames an export, a browser holding a CACHED index.html alongside a
# FRESH scoring.js fails to link the module, and an ES module that fails to
# link does not run at all, so the page renders its header and nothing else.
# That is not a visible error, it is a blank screen.
#
# It happened: v4 renamed the scoring exports and anyone who had loaded the v3
# page got a white page until they hard-refreshed.
#
# So: HTML must always be revalidated, and never served from a browser cache
# without checking. The assets it points at are versioned in the URL and can be
# cached hard.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Always ask. HTML is the file that names which module versions to load, so a
# stale copy is the one thing that can break the page outright.
/
  Cache-Control: no-cache
/*.html
  Cache-Control: no-cache
/setlist/
  Cache-Control: no-cache

# The game's modules and data carry ?v= in their URLs, so a given URL's content
# never changes and can be held for a year.
/setlist/*.js
  Cache-Control: public, max-age=31536000
/setlist/data/*
  Cache-Control: public, max-age=31536000

# Run The Arcade. Its pages are served at /arcade/ and /arcade/<game>/ (no
# ".html" in the URL, so the /*.html rule above never matches them), so those
# are revalidated on every load: a push to main reaches every phone on the next
# visit.
#
# Its scripts are held for a year. Every tag that loads one carries a ?v=
# version, check-cachebust fails CI when a script changes without a bump, and
# check-arcade-cache fails on an arcade script tag with no version. So a given
# script URL's bytes never change. A game page loads 34 to 50 scripts; before
# this, every visit asked again for every one of them. The stylesheet stays on
# revalidate: check-cachebust does not record stylesheets, so a year's cache
# could keep an edit from reaching a phone.
#
# There is deliberately no /arcade/* rule. Cloudflare joins a header set by two
# matching rules, so the old "/arcade/* no-cache" turned every rule below it
# into "no-cache, public, max-age=...", and no-cache won: the assets' week
# never applied. check-arcade-cache holds this block's shape.
/arcade/
  Cache-Control: no-cache
/arcade/*/
  Cache-Control: no-cache
/arcade/*.js
  Cache-Control: public, max-age=31536000, immutable
/arcade/*.css
  Cache-Control: no-cache

# The arcade's icons and share images rarely change: a week.
/arcade/assets/*
  Cache-Control: public, max-age=604800

# EVERY OTHER PAGE SERVED AT A DIRECTORY URL, for the reason the arcade block
# above states: the request path for runthe.gg/mythiball/ is "/mythiball/",
# which does not end in ".html", so the /*.html rule never matched it. Only
# /setlist/ and /arcade/ had ever been given their own line, so the other
# eighteen pages on this site fell through to whatever the browser decided.
#
# That is the rule this file opens by stating, applied to the pages it was
# missing. A push to main should reach a phone on the next load; without this
# a tester can sit on a cached copy and report a screen that no longer exists.
/baseball/
  Cache-Control: no-cache
/cfb/
  Cache-Control: no-cache
/challenge/
  Cache-Control: no-cache
/football/
  Cache-Control: no-cache
/golf/
  Cache-Control: no-cache
/hoops/
  Cache-Control: no-cache
/ideas/
  Cache-Control: no-cache
/mythiball/
  Cache-Control: no-cache
/pitch/
  Cache-Control: no-cache
/soccer/
  Cache-Control: no-cache
/touchdown/
  Cache-Control: no-cache
/watch/
  Cache-Control: no-cache
/wrestling/
  Cache-Control: no-cache

# Shut The Door's 3D scene (unlisted). The game's page and the lab's are revalidated like every
# page. Every file the scene loads has a version in its URL: modules carry ?v= (held by
# scripts/check-cachebust.mjs), assets carry a content hash ?h= (written by
# shut-the-door/lab/pipeline/stamp.mjs), and three.js sits in a folder named for its release.
# A changed file gets a new URL, so a URL's bytes never change and a phone can keep them for a
# year without asking again. Scoped to the game's 3D folder and the lab only.
/shut-the-door/
  Cache-Control: no-cache
/shut-the-door/3d/*
  Cache-Control: public, max-age=31536000, immutable
/shut-the-door/lab/
  Cache-Control: no-cache
/shut-the-door/lab/*.js
  Cache-Control: public, max-age=31536000, immutable
