{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://runthe.gg/schema/case.schema.json",
  "title": "RunTheCase Case File",
  "description": "A single hand-authored case. Same schema for career and quick modes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "mode", "title", "briefing", "clue_total", "location_hotspots", "evidence", "suspects", "solution"],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^(modern|noir|1700s|future)_[0-9]{2,3}_[a-z0-9_]+$",
      "description": "e.g. modern_30_cleanup_crew"
    },
    "mode": { "type": "string", "enum": ["career", "quick"] },
    "title": { "type": "string" },
    "rank_required": {
      "type": ["string", "null"],
      "enum": ["cadet", "junior", "detective", "senior", "homicide", "major_crimes", "finale", null],
      "description": "null for quick mode"
    },
    "order_in_rank": { "type": ["integer", "null"], "minimum": 1 },
    "quick_flavor": {
      "type": ["string", "null"],
      "enum": ["locked_room", "poisoning", "mob_hit", "domestic", "missing_person", "white_collar", "cold_case", null],
      "description": "only set when mode == quick"
    },
    "briefing": { "type": "string" },
    "partner_id": { "type": ["string", "null"], "description": "ref -> characters.json id" },
    "clue_total": {
      "type": "integer",
      "minimum": 0,
      "description": "Total discoverable clues; denominator for the clue-% scorecard. Must equal count of evidence with is_clue==true (validator enforces)."
    },
    "give_up": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed": { "type": "boolean", "default": true },
        "min_investigation_pct": {
          "type": "number", "minimum": 0, "maximum": 1, "default": 0.3,
          "description": "Fraction of clues that must be found before the case can be formally given up, to stop players skipping content."
        }
      }
    },
    "location_hotspots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "evidence_ids"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "requires_specialist": {
            "type": ["string", "null"],
            "enum": ["forensics", "digital_forensics", "me", null],
            "description": "If set, hotspot only yields evidence after calling this specialist (costs in-game time)."
          },
          "evidence_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "tier", "is_clue"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "tier": { "type": "string", "enum": ["physical", "digital", "testimonial", "circumstantial"] },
          "description": { "type": "string" },
          "is_clue": {
            "type": "boolean",
            "description": "Counts toward clue_total / clue-% scorecard. Background-flavor evidence is false."
          },
          "unlocks_board_connections": { "type": "array", "items": { "type": "string" }, "default": [] },
          "unlocks_dialogue": { "type": "array", "items": { "type": "string" }, "default": [] },
          "thread_tag": {
            "type": ["string", "null"],
            "description": "ref -> threads.json breadcrumb id. Hidden breadcrumbs use is_clue:false + a thread_tag."
          }
        }
      }
    },
    "board_connections": {
      "type": "array",
      "description": "Valid connections the player can make on the Board. Wrong connections simply aren't listed (safe exploration).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from", "to"],
        "properties": {
          "id": { "type": "string" },
          "from": { "type": "string", "description": "evidence id or suspect id" },
          "to": { "type": "string", "description": "evidence id or suspect id" },
          "unlocks_dialogue": { "type": "array", "items": { "type": "string" }, "default": [] },
          "unlocks_hotspots": { "type": "array", "items": { "type": "string" }, "default": [] },
          "reveals_suspect": { "type": ["string", "null"], "default": null }
        }
      }
    },
    "suspects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "is_guilty"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "character_id": { "type": ["string", "null"], "description": "ref -> characters.json for recurring NPCs" },
          "motive": { "type": "string" },
          "alibi": { "type": "string" },
          "is_guilty": { "type": "boolean" },
          "dialogue_tree_id": { "type": ["string", "null"], "description": "ref into dialogue_trees below" }
        }
      }
    },
    "dialogue_trees": {
      "type": "array",
      "description": "Interrogation trees. Referenced by suspects[].dialogue_tree_id.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "root_node", "nodes"],
        "properties": {
          "id": { "type": "string" },
          "root_node": { "type": "string" },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "speaker_line"],
              "properties": {
                "id": { "type": "string" },
                "speaker_line": { "type": "string" },
                "locked_until_evidence": {
                  "type": ["string", "null"],
                  "description": "Node only reachable once this evidence id is logged."
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["text", "goto"],
                    "properties": {
                      "text": { "type": "string" },
                      "present_evidence_id": {
                        "type": ["string", "null"],
                        "description": "If set, this option presents that evidence. Right evidence advances; wrong evidence routes to a defensive node."
                      },
                      "goto": { "type": "string", "description": "next node id, or 'END'" },
                      "effect": {
                        "type": ["string", "null"],
                        "enum": ["break_alibi", "catch_contradiction", "force_admission", "suspect_lawyers_up", "partner_trust_up", "partner_trust_down", null]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "solution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correct_suspect", "required_evidence", "correct_motive"],
      "properties": {
        "correct_suspect": { "type": "string", "description": "ref -> suspects[].id (must be is_guilty:true)" },
        "required_evidence": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Evidence that must be cited for an 'airtight' accusation (evidence axis of the score)."
        },
        "correct_motive": { "type": "string" }
      }
    },
    "consequence_hooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wrongful_accusation_targets": {
          "type": "array", "items": { "type": "string" },
          "description": "suspect ids that, if wrongly accused, trigger recurring-NPC / reputation consequences"
        },
        "recurring_npc_spawns": {
          "type": "array", "items": { "type": "string" },
          "description": "character ids that enter the world on wrongful accusation (e.g. lawyer_grant)"
        },
        "partner_override_trust_delta": {
          "type": "integer",
          "description": "Trust change applied if the player overrides the partner and is wrong."
        }
      }
    },
    "rewards": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "xp": { "type": "integer", "minimum": 0 },
        "skill_points": { "type": "integer", "minimum": 0 },
        "badges": { "type": "array", "items": { "type": "string" }, "description": "ref -> badges.json ids" }
      }
    },
    "thread_tags": {
      "type": "array", "items": { "type": "string" },
      "description": "ref -> threads.json breadcrumb ids present in this case"
    },
    "promotion_gate": {
      "type": ["boolean", "null"],
      "description": "If true, solving this case is the story-gate that triggers promotion out of its rank."
    }
  }
}
