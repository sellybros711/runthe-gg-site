{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://runthe.gg/schema/career.schema.json",
  "title": "RunTheCase Career Configuration",
  "description": "Ranks, promotion gates, reputation tiers, the wrongful-accusation firing curve, and scoring weights. Loaded once at boot per ENGINE-SPEC §1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ranks", "reputation", "firing", "scoring"],
  "properties": {
    "ranks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "order", "name"],
        "properties": {
          "id": { "type": "string", "enum": ["cadet", "junior", "detective", "senior", "homicide", "major_crimes", "finale"] },
          "order": { "type": "integer", "minimum": 1 },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "promotion_gate": {
            "type": "object",
            "additionalProperties": false,
            "description": "Absent on the final rank (finale has no further promotion).",
            "properties": {
              "min_closure_rate": { "type": "number", "minimum": 0, "maximum": 1 },
              "min_accuracy": { "type": "number", "minimum": 0, "maximum": 1 },
              "min_reputation_tier": { "type": ["string", "null"] },
              "story_gate_case": { "type": ["string", "null"], "description": "ref -> case_id that must be solved-correct" }
            }
          }
        }
      }
    },
    "reputation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max", "start", "tiers"],
      "properties": {
        "min": { "type": "integer" },
        "max": { "type": "integer" },
        "start": { "type": "integer" },
        "tiers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "min"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "min": { "type": "integer" }
            }
          }
        }
      }
    },
    "firing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reputation_floor", "wrongful_accusation_curve"],
      "properties": {
        "reputation_floor": { "type": "integer" },
        "other_fire_triggers": { "type": "array", "items": { "type": "string" }, "default": [] },
        "wrongful_accusation_curve": {
          "type": "array",
          "description": "Indexed by cumulative wrongful_accusations count (post-increment). Entry N applies on the Nth wrongful accusation.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["count", "reputation_delta", "consequence", "fireable"],
            "properties": {
              "count": { "type": "integer", "minimum": 1 },
              "reputation_delta": { "type": "integer" },
              "consequence": { "type": "string" },
              "fireable": { "type": "boolean" }
            }
          }
        }
      }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suspect_weight", "evidence_weight", "motive_weight"],
      "properties": {
        "suspect_weight": { "type": "number" },
        "evidence_weight": { "type": "number" },
        "motive_weight": { "type": "number" }
      }
    }
  }
}
