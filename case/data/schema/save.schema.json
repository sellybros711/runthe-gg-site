{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://runthe.gg/schema/save.schema.json",
  "title": "RunTheCase Save State",
  "description": "Persistent player save. Career mode only (ENGINE-SPEC §8: Quick Case never writes here). One save per profile; this build persists it to localStorage.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "detective", "career_stats", "casebook", "relationships", "flags", "badges_earned"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "detective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "reputation", "employment"],
      "properties": {
        "rank": { "type": "string", "enum": ["cadet", "junior", "detective", "senior", "homicide", "major_crimes", "finale"] },
        "reputation": { "type": "integer" },
        "employment": { "type": "string", "enum": ["active", "fired"] }
      }
    },
    "career_stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wrongful_accusations", "cases_given_up", "clues_found_total", "clues_possible_total"],
      "properties": {
        "wrongful_accusations": { "type": "integer", "minimum": 0 },
        "cases_given_up": { "type": "integer", "minimum": 0 },
        "clues_found_total": { "type": "integer", "minimum": 0 },
        "clues_possible_total": { "type": "integer", "minimum": 0 }
      }
    },
    "casebook": {
      "type": "object",
      "description": "Keyed by case_id.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status"],
        "properties": {
          "status": { "type": "string", "enum": ["unopened", "in_progress", "solved", "given_up"] },
          "correct": { "type": "boolean" },
          "shaky": { "type": "boolean" },
          "evidence_logged": { "type": "array", "items": { "type": "string" } },
          "specialists_called": { "type": "array", "items": { "type": "string" } },
          "clues_found": { "type": "integer", "minimum": 0 },
          "hotspots_unlocked": { "type": "array", "items": { "type": "string" } },
          "dialogue_unlocked": { "type": "array", "items": { "type": "string" } },
          "board_connections_made": { "type": "array", "items": { "type": "string" } },
          "phase": {
            "type": "string",
            "enum": ["briefing", "investigation", "board", "interrogation", "accusation", "resolution"],
            "description": "Where the player left off, for free case-switching mid-investigation."
          }
        }
      }
    },
    "relationships": {
      "type": "object",
      "description": "Keyed by character_id (partners).",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trust", "status"],
        "properties": {
          "trust": { "type": "integer", "minimum": 0, "maximum": 100 },
          "status": { "type": "string", "enum": ["active", "strained", "quit"] }
        }
      }
    },
    "flags": {
      "type": "object",
      "description": "Spoiler-safe thread flags, e.g. seen_bc_voss_invoice: true. Never surfaced verbatim to the player (ENGINE-SPEC §5).",
      "additionalProperties": { "type": "boolean" }
    },
    "badges_earned": { "type": "array", "items": { "type": "string" } },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "description": "Open-world state: which recurring NPCs have spawned into the world as a consequence of prior cases.",
      "properties": {
        "npc_spawns": { "type": "array", "items": { "type": "string" }, "default": [] },
        "wronged_suspects": { "type": "array", "items": { "type": "string" }, "default": [] }
      }
    }
  }
}
